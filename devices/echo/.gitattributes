# Files that run on the Echo (busybox sh, the patch for librespot) keep LF on every checkout:
# a Windows checkout with CRLF breaks them on the device.
*.sh      text eol=lf
*.script  text eol=lf
*.pa      text eol=lf
*.conf    text eol=lf
*.patch   text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.tflite  binary
# The Dot's PID 1 script (no extension), packed into its boot image by hardware/dot2/tools/build-image.py
hardware/dot2/tools/init text eol=lf
