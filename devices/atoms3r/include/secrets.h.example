#pragma once

// Copy to include/secrets.h (ignored by git) and fill in. Only WiFi and the OpenAI key are
// required; every other block is optional and its features switch off when it stays empty.

// --- Required ----------------------------------------------------------------------------
#define WIFI_SSID "my-wifi"
#define WIFI_PASSWORD "my-password"
// https://platform.openai.com/api-keys. Prefer a project key with a spending limit.
#define OPENAI_API_KEY "sk-..."

// --- The assistant -----------------------------------------------------------------------
// Its name as people say and hear it (default "Jarvis"; the Echos read it from the same file through
// core/tools/make_secrets.py). Home Assistant events and entities take its slug as prefix
// (jarvis_announce, binary_sensor.jarvis_presence). The built-in wake word stays "Hey Jarvis" unless
// an own model is set up (tools/wakeword). Its character: shared/prompts/persona.h, or your own in
// shared/prompts/persona_local.h (see there).
// #define ASSISTANT_NAME "Jarvis"

// --- Household ---------------------------------------------------------------------------
// The admin: the person who owns the device. Registered on every start with PHONE_OWNER,
// TELEGRAM_OWNER_ID and OWNER_EMAIL; everyone else is added by voice ("Das ist Anna").
#define OWNER_NAME "Alex"
#define OWNER_EMAIL "alex@example.com"

// --- Home Assistant (optional) -----------------------------------------------------------
// HA with the "Model Context Protocol Server" integration.
// Token: HA profile -> Security -> Long-lived access tokens.
#define HA_URL "http://homeassistant.local:8123"
#define HA_TOKEN "eyJ..."

// --- Telegram (optional) -----------------------------------------------------------------
// Token: @BotFather -> /newbot. Owner: your numeric Telegram user id; leave it 0, write to the
// bot, and it answers with your id.
#define TELEGRAM_BOT_TOKEN "123456789:AA..."
#define TELEGRAM_OWNER_ID 0

// --- WhatsApp (optional): The assistant on a number of its own, see README -------------------------
// Relay: the Cloudflare Worker of services/whatsapp-relay/ and its DEVICE_TOKEN. Phone number id: Meta's
// id of the registered number. Access token: a system user's token that never expires
// (permissions whatsapp_business_messaging, whatsapp_business_management).
#define WHATSAPP_RELAY_URL "https://assistant-whatsapp-relay.example.workers.dev"
#define WHATSAPP_RELAY_TOKEN "..."
#define WHATSAPP_PHONE_NUMBER_ID "123456789012345"
#define WHATSAPP_ACCESS_TOKEN "EAA..."

// --- The assistant's own mailbox (optional): mail commands, sending, printing by mail -------------
#define MAIL_ADDRESS "assistant@example.com"
#define MAIL_PASSWORD "..."
#define MAIL_SMTP_HOST "smtp.example.com"  // SMTPS, port 465 (config.h)
#define MAIL_IMAP_HOST "imap.example.com"  // IMAPS, port 993
#define MAIL_SENT_FOLDER "Sent"            // the provider's folder for sent mail
// Mails count as commands only if the provider verified them: the name at the start of its
// Authentication-Results header (e.g. "mail.example.com"). Empty: no mail is taken as a command.
#define MAIL_AUTHSERV_ID ""
// The root certificate of the provider is MAIL_CA in src/services/ca_certs.cpp.

// --- Watched private mailboxes (optional) ---------------------------------------------------
// The assistant reads them, sorts new mail and tells the owner what matters; it moves mails only on the
// owner's request or rule (folders, archive, trash; never deletes for good). Gmail needs a token
// with gmail.modify for that (google_auth.py since 2026-10; an older read-only token still reads).
// {person ("" = the admin, else name or id in the register), label, IMAP host or "gmail", user,
// IMAP password or Gmail refresh token ("" = GOOGLE_REFRESH_TOKEN; another person's from
// scripts/google_auth.py --gmail-only)}. IMAP: port 993 and the same root CA as the assistant's mailbox.
#define WATCHED_MAILBOXES \
    {"", "Privat", "imap.example.com", "me@example.com", "..."}, \
    {"", "Gmail", "gmail", "", ""}

// --- Printer (optional) ------------------------------------------------------------------
#define PRINTER_HOST ""   // IPP(S) printer in the LAN, e.g. "192.168.1.50"
#define PRINTER_EMAIL ""  // the printer's e-mail print address (PDFs, images), e.g. Epson Connect

// --- Several devices (optional, Echo): the link between them (devices/echo/docs/18-several-echos.md)
// A shared random secret, at least 16 characters, the same on every device; "" = this device acts
// alone (standalone: memory, chats, phone and tasks here). Set: a member of the network next to
// the Echos, which keep memory, tasks and people (docs/architecture.md, A network of devices).
#define PEER_KEY ""
#define DEVICE_NAME ""  // in the network ("" = "M5"), e.g. "Küche"
#define DEVICE_ROOM ""  // the room it stands in, named as the Home Assistant area

// --- Phone (optional): The assistant as an IP phone, e.g. of a FritzBox --------------------------
// FritzBox: Telefonie -> Telefoniegeraete -> Neues Geraet -> Telefon (LAN/WLAN).
#define SIP_REGISTRAR "192.168.178.1"
#define SIP_USER "assistant"
#define SIP_PASSWORD "..."
// Further numbers that get the assistant with memory and tools, comma separated ("**" = the phone
// system's own phones). People of the household need no entry: they are released with their
// numbers when the admin registers them ("gib Kontakt Anna frei"). Other callers are answered as
// guests (no memory, no tools; the assistant takes a message and reports it).
#define PHONE_CALLERS "**"
// The number people dial to reach the assistant; it is mentioned in the welcome mail. "" = not mentioned.
#define ASSISTANT_PHONE_NUMBER ""
// The admin's own number: phone_call ("ruf mich an", wake-up calls) calls it.
#define PHONE_OWNER "+49170..."
// Callers type this on the keypad, then #, before the assistant listens. "" = no PIN.
#define PHONE_PIN ""

// --- Google account (optional): calendars, contacts, Tasks, Drive, Sheets -----------------
// Run scripts/google_auth.py once (see docs/google.md); it fills these in.
#define GOOGLE_CLIENT_ID ""
#define GOOGLE_CLIENT_SECRET ""
#define GOOGLE_REFRESH_TOKEN ""
// OAuth client of type "Web application" with the redirect URI <WHATSAPP_RELAY_URL>/google: lets
// the assistant renew an expired login itself (a link to the admin; docs/google.md). With it the three
// values above are optional: the first link logs in.
#define GOOGLE_WEB_CLIENT_ID ""
#define GOOGLE_WEB_CLIENT_SECRET ""
// A member (ASSISTANT_INBOUND 0) never sends the login link: give it the main Echo's login here (the
// refresh_token of the Echo's google.json, web client). Used when no login from a link is stored,
// or when the stored one is refused.
#define GOOGLE_REFRESH_TOKEN_WEB ""
// API key for Places, Routes, Weather, Pollen, Air Quality and the YouTube search.
#define GOOGLE_MAPS_API_KEY ""
// Gemini API key (Google AI Studio, an "auth key" bound to a service account): summarize_video.
#define GEMINI_API_KEY ""

// --- Web search (optional) -------------------------------------------------------------------
// Tavily API key (app.tavily.com, 1,000 free searches a month). Empty: OpenAI's hosted web
// search, about 1 ct per search.
#define TAVILY_API_KEY ""
// Admin key for scripts/openai_costs.py only (platform.openai.com -> Organization -> Admin
// keys). Never used by the firmware.
#define OPENAI_ADMIN_KEY ""

// --- Spotify (optional, Premium): music on any Spotify Connect speaker, playlists, library ----
// App: developer.spotify.com/dashboard, redirect URI http://127.0.0.1:8888/callback, Web API.
// Then python scripts/spotify_auth.py fills in SPOTIFY_REFRESH_TOKEN (the admin's account).
#define SPOTIFY_CLIENT_ID ""
#define SPOTIFY_CLIENT_SECRET ""
#define SPOTIFY_REFRESH_TOKEN ""
// Other people's accounts: {person (name or id in the register), refresh token from
// scripts/spotify_auth.py --other}. Each must be a user of the app (User Management, max 5).
#define SPOTIFY_ACCOUNTS
// Spotify devices in the assistant's room, comma separated, as Spotify names them: music there gets
// quieter while the assistant talks; the first plays "spiel ..." when nothing plays anywhere. "" = music
// on every speaker at home gets quieter (not on phones or computers).
#define SPOTIFY_ROOM_SPEAKERS ""
