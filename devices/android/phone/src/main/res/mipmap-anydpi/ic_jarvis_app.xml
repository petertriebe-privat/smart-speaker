<?xml version="1.0" encoding="utf-8"?>
<!-- The app's icon as an adaptive icon: the hologram on the HUD's dark ground, inside the safe
     zone. Android Auto set the plain square picture on a white disc (03.11.2026). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/jarvis_ground" />
    <foreground>
        <inset android:drawable="@drawable/icon" android:inset="20dp" />
    </foreground>
</adaptive-icon>
